{
  "name": "pr-radar",
  "productName": "PR Radar",
  "version": "0.7.0",
  "description": "Menu bar app that notifies you about GitHub pull requests waiting for your review",
  "main": "./out/main/index.js",
  "author": "gmunozc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmunozc/pr-radar.git"
  },
  "homepage": "https://github.com/gmunozc/pr-radar#readme",
  "bugs": {
    "url": "https://github.com/gmunozc/pr-radar/issues"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
