# Client ID of your GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# "Enable Device Flow" must be checked. The client ID is not a secret.
MAIN_VITE_GITHUB_CLIENT_ID=

# Optional: the read-only GitHub App (preferred sign-in when set). Settings → Developer
# settings → GitHub Apps; enable Device Flow; read-only Pull requests, Checks, Commit statuses
# and organization Members. The slug is the last part of https://github.com/apps/<slug>.
MAIN_VITE_GITHUB_APP_CLIENT_ID=
MAIN_VITE_GITHUB_APP_SLUG=

# Optional: owner/repo whose GitHub releases are checked for new versions (forks set their own;
# empty turns the check off).
MAIN_VITE_UPDATE_REPO=
